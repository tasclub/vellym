{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellym.tasclub.com/schemas/v1/page.schema.json",
  "title": "Vellym Page v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "vellym.tasclub.com/v1" },
    "kind": { "const": "Page" },
    "metadata": {
      "type": "object",
      "required": ["name", "title"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "slug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[\\p{L}\\p{N}]+(?:-[\\p{L}\\p{N}]+)*$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["blocks"],
      "properties": {
        "documentType": { "type": "string" },
        "locale": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
