{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellym.tasclub.com/schemas/page-translation.schema.json",
  "title": "Vellym Page translation",
  "type": "object",
  "required": ["title", "blocks"],
  "properties": {
    "visibility": { "enum": ["draft", "published"] },
    "title": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
