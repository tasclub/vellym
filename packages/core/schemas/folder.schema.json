{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellym.tasclub.com/schemas/folder.schema.json",
  "title": "Vellym Folder",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "vellym.tasclub.com/v1alpha1",
        "vellym.tasclub.com/v1"
      ]
    },
    "kind": {
      "const": "Folder"
    },
    "metadata": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "translations": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
