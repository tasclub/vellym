{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellym.tasclub.com/schemas/plugin-manifest.schema.json",
  "title": "Vellym plugin manifest (package.json \"vellym\" field)",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "styles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.css$"
      }
    },
    "guideUrl": {
      "type": "object",
      "description": "Where `vellym init` points people to read how to use this plugin, per UI language.",
      "properties": {
        "ja": {
          "type": "string",
          "pattern": "^https://"
        },
        "en": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "contributes": {
      "type": "object",
      "properties": {
        "guide": {
          "type": "object",
          "required": ["id", "title", "file"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "title": {
              "type": "object", "required": ["ja", "en"],
              "properties": { "ja": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            },
            "file": {
              "type": "object", "required": ["ja", "en"],
              "properties": {
                "ja": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.md$" },
                "en": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.md$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "group"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "file": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.json$" },
              "group": {
                "type": "object",
                "required": ["ja", "en"],
                "properties": {
                  "ja": { "type": "string", "minLength": 1 },
                  "en": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              },
              "showInDocumentTree": {
                "type": "boolean"
              },
              "hasBlocks": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "type",
              "static"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "list",
                  "detail"
                ]
              },
              "static": {
                "type": "boolean"
              },
              "opensKind": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "static"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "$ref": "#/$defs/localizedText"
              },
              "static": {
                "type": "boolean"
              },
              "placement": {
                "enum": [
                  "view",
                  "document-tree"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "$ref": "#/$defs/localizedText"
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "boolean",
                  "select"
                ]
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "$ref": "#/$defs/localizedText"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
