{
  "name": "vellym-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace @vellym/plugin-api --workspace @vellym-internal/ui-react --workspace @vellym/tickets && node scripts/build.mjs",
    "dev": "npm run build && node packages/vellym/dist/cli.mjs dev",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "npm run build && vitest run",
    "coverage": "npm run build && vitest run --coverage",
    "validate": "npm run build && node packages/vellym/dist/cli.mjs validate --config how-to-use/vellym.config.yaml",
    "pack:check": "npm run build && npm pack --workspace vellym --dry-run --json",
    "pack:smoke": "npm run build && sh scripts/smoke-pack.sh",
    "smoke:100": "npm run build && node scripts/smoke-100-pages.mjs",
    "verify:core": "npm run build && node scripts/verify-core.mjs",
    "verify:scale": "npm run build && node scripts/bench-fixture.mjs --out /tmp/vellym-ci-scale-3000 --pages 3000 && node scripts/bench-scale.mjs --config /tmp/vellym-ci-scale-3000/vellym.config.yaml --port 4277 --label ci-3000 --assert",
    "site:build": "npm run build && node scripts/build-site.mjs",
    "site:verify": "npm run site:build && node scripts/verify-site.mjs",
    "release:check": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "semver": "^7.7.2",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "vite": "8.2.1",
    "nanoid": "^3.3.17"
  }
}
